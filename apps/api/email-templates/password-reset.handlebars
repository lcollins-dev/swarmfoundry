{{#if subject}}
Reset your Swarmfoundry password
{{/if}}
{{#if text}}
Hi {{name}},

An admin has requested a password reset for your Swarmfoundry account. Use the link below to choose a new password.

{{link}}

This link can be used once and expires in {{lifetime}}. If you weren't expecting this email, you can ignore it.

Swarmfoundry
{{/if}}
{{#if html}}
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <style>
      .container {
        width: 100%;

        padding: 20px;

        font-family: 'open sans', 'helvetica neue', sans-serif;
        font-size: 18px;

        background-color: #f6f6f6;
      }

      .content {
        margin: 0 auto;
        max-width: 500px;
      }

      .inner-content {
        padding: 30px;

        background-color: white;

        border: 1px solid #eee;
        border-radius: 10px;
      }

      .bold {
        font-weight: bold;
      }

      .newline {
        margin-bottom: 18px !important;
      }

      .button-container {
        display: flex;
      }

      .button-container,
      * {
        margin: 0 auto;
      }

      button {
        padding: 8px 12px;

        color: white;
        font-size: 18px;
        font-weight: bold;

        background-color: #89c8fd;

        border: 1px solid white;
        border-radius: 5px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="content">
        <div class="inner-content">
          <div class="newline bold">Hi {{name}},</div>

          <div class="newline">An admin has requested a password reset for your Swarmfoundry account. Use the button below to choose a new password.</div>

          <div class="button-container newline">
            <a href="{{link}}">
              <button>Reset Password</button>
            </a>
          </div>

          <div class="newline">This link can be used once and expires in {{lifetime}}. If you weren't expecting this email, you can ignore it.</div>

          <div class="bold">Swarmfoundry</div>
        </div>
      </div>
    </div>
  </body>
</html>
{{/if}}
