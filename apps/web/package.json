{
  "name": "@apps/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc && vite build",
    "start": "npm run start:dev",
    "start:dev": "vite",
    "start:prod": "vite preview --port 8080",
    "test": "vitest run",
    "test:watch": "vitest",
    "code:lint": "eslint .",
    "code:lint:fix": "eslint . --fix",
    "code:format": "prettier --write .",
    "code:format:check": "prettier --check .",
    "code:typecheck": "vue-tsc --noEmit",
    "npm:clean": "rm -rf node_modules"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/ubuntu-mono": "5.2.8",
    "@vueuse/core": "14.1.0",
    "axios": "1.20.0",
    "moment": "2.31.0",
    "pinia": "3.0.4",
    "pino": "10.1.0",
    "vue": "3.5.43",
    "vue-dompurify-html": "5.3.0",
    "vue-router": "4.6.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "1.2.93",
    "@nabla/vite-plugin-eslint": "2.0.6",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.3",
    "@vue/test-utils": "2.4.10",
    "eslint-plugin-vue": "10.6.2",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "unplugin-icons": "24.0.0",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "6.0.3",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.2.1"
  }
}
