{
  "name": "e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests for Swarmfoundry",
  "scripts": {
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "codegen": "playwright codegen $E2E_BASE_URL",
    "install-browsers": "playwright install chromium",
    "code:lint": "eslint .",
    "code:lint:fix": "eslint . --fix",
    "code:format": "prettier --write .",
    "code:format:check": "prettier --check .",
    "code:typecheck": "tsc --noEmit",
    "npm:clean": "rm -rf node_modules"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "22.17.2",
    "@types/pg": "8.15.5",
    "bcryptjs": "3.0.3",
    "pg": "8.16.3",
    "typescript": "5.9.3"
  }
}
